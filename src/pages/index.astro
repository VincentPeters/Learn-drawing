---
import Base from '../layouts/Base.astro';
import Diagram from '../components/Diagram.astro';
import { MODULES, lessonUrl, moduleUrl } from '../lib/modules';
import { lessonsOf, phasesOf, sequence } from '../lib/course';

const groups = [];
for (const m of [1, 2] as const) {
  groups.push({ mm: MODULES[m], lessons: await lessonsOf(m), phases: await phasesOf(m) });
}
const seq = (await sequence()).map(({ m, n, title, url }) => ({ m, n, title, url }));
---
<Base
  title="Draft30 — Learn Technical Drawing &amp; Rendering in 45 Lessons"
  description="A free, visual, 45-lesson course in two modules: technical/engineering drawing (orthographic, isometric, dimensioning, sections) then rendering, shading and colour."
  active="home"
>
  <!-- THE SHEET -->
  <div class="wrap">
    <header class="sheet">
      <div class="sheet-inner">
        <div>
          <h1>Learn technical drawing in 45 lessons.</h1>
          <p class="lead">Two modules take you from your first freehand line to a finished, dimensioned drawing — then on to shading, light and colour. No software, no expensive kit. <b>Just a pencil and some paper.</b></p>
          <div class="hero-cta">
            <a href={lessonUrl(1, 1)} class="btn btn-primary">Start the course</a>
            <a href={moduleUrl(1)} class="btn btn-ghost">See the course map</a>
          </div>
        </div>
        <div class="hero-fig">
          <svg viewBox="0 0 460 340" xmlns="http://www.w3.org/2000/svg" class="dg" role="img" aria-label="Orthographic and isometric views of a bracket">
            <defs>
              <marker id="ha" markerWidth="10" markerHeight="10" refX="8" refY="3" orient="auto" markerUnits="strokeWidth"><path d="M8,0 L8,6 L0,3 Z" class="fill-soft"/></marker>
              <marker id="hb" markerWidth="10" markerHeight="10" refX="0" refY="3" orient="auto" markerUnits="strokeWidth"><path d="M0,0 L0,6 L8,3 Z" class="fill-soft"/></marker>
            </defs>
            <!-- FRONT view -->
            <path d="M60,250 L170,250 L170,190 L110,190 L110,140 L60,140 Z" class="ln-visible fill-paper"/>
            <circle cx="85" cy="215" r="12" class="ln-visible fill-none"/>
            <line x1="70" y1="215" x2="100" y2="215" class="ln-center"/>
            <line x1="85" y1="200" x2="85" y2="230" class="ln-center"/>
            <line x1="60" y1="270" x2="170" y2="270" class="ln-dim" marker-start="url(#hb)" marker-end="url(#ha)"/>
            <rect x="105" y="263" width="22" height="14" class="fill-paper"/>
            <text x="107" y="274" class="dg-lbl-ink">100</text>
            <text x="60" y="300" class="dg-lbl-blue">FRONT</text>
            <!-- TOP view -->
            <rect x="60" y="60" width="110" height="55" class="ln-visible fill-paper"/>
            <line x1="85" y1="60" x2="85" y2="115" class="ln-center"/>
            <text x="60" y="50" class="dg-lbl-blue">TOP</text>
            <line x1="60" y1="115" x2="60" y2="140" class="ln-constr"/>
            <line x1="170" y1="115" x2="170" y2="140" class="ln-constr"/>
            <!-- ISO pictorial -->
            <g transform="translate(300,130)">
              <path d="M0,60 L60,25 L120,60 L60,95 Z" class="ln-visible fill-paper"/>
              <path d="M0,60 L0,140 L60,175 L60,95 Z" class="ln-visible fill-paper" opacity=".92"/>
              <path d="M120,60 L120,120 L96,133 L96,88 L60,108 L60,175 Z" class="ln-visible fill-paper" opacity=".8"/>
              <ellipse cx="42" cy="112" rx="13" ry="20" transform="rotate(-30 42 112)" class="ln-blue fill-none"/>
            </g>
            <text x="300" y="330" class="dg-lbl-accent">ISOMETRIC</text>
          </svg>
          <div class="fig-cap">Fig. 1 — Module 1 · you draw this</div>
        </div>
      </div>
      <div class="titleblock" aria-label="Sheet title block">
        <div><span class="tb-k">Title</span><span class="tb-v">Draft30 — Technical Drawing &amp; Rendering</span></div>
        <div><span class="tb-k">Lessons</span><span class="tb-v">45 · 2 modules</span></div>
        <div><span class="tb-k">Session</span><span class="tb-v">45–90 min</span></div>
        <div><span class="tb-k">Tools</span><span class="tb-v">pencil · paper</span></div>
      </div>
    </header>
  </div>

  <!-- CONTINUE / START -->
  <section style="padding: 0 0 8px">
    <div class="wrap">
      <div class="continue-band" id="continue-band"></div>
    </div>
  </section>

  <!-- WHAT YOU LEARN -->
  <section>
    <div class="wrap">
      <div class="chapter">
        <h2>What you'll actually be able to do</h2>
        <p class="ch-intro">Across two modules you go from precise line work to fully rendered, coloured plates. <b>Module 1</b> builds the engineering drawing; <b>Module 2</b> brings it to life with tone, light and colour. You learn it by hand, because working it out on paper is what makes it stick.</p>
      </div>
      <div class="manual-cols">
        <div class="manual-entry">
          <h3><span class="me-mark">M1</span> Draw a confident line</h3>
          <p>Steady freehand lines and clean ellipses, plus the standard "alphabet of lines" that every drawing is built from.</p>
        </div>
        <div class="manual-entry">
          <h3><span class="me-mark">M1</span> Project any object</h3>
          <p>Turn a 3-D part into aligned front, top, and side views in both first and third angle, and work out a missing view from two.</p>
        </div>
        <div class="manual-entry">
          <h3><span class="me-mark">M1</span> Draw in 3-D</h3>
          <p>Isometric, oblique, and one- and two-point perspective, including the isometric circles and cylinders that trip most people up.</p>
        </div>
        <div class="manual-entry">
          <h3><span class="me-mark">M1</span> Dimension &amp; section it</h3>
          <p>Dimensions, tolerances and fits, a first look at GD&amp;T, section and auxiliary views, plus thread and fastener shorthand.</p>
        </div>
        <div class="manual-entry">
          <h3><span class="me-mark">M1</span> Finish a real sheet</h3>
          <p>Intersections, flat-pattern developments, assemblies with a parts list, and a complete title-blocked capstone drawing.</p>
        </div>
        <div class="manual-entry m2">
          <h3><span class="me-mark">M2</span> Shade with tone</h3>
          <p>A clean value scale and hatching that follows the form — the cross-hatched look of the academic constructive tradition.</p>
        </div>
        <div class="manual-entry m2">
          <h3><span class="me-mark">M2</span> Read the light</h3>
          <p>One light source, six readable zones — highlight, core shadow, reflected light, and constructed cast shadows that ground the form.</p>
        </div>
        <div class="manual-entry m2">
          <h3><span class="me-mark">M2</span> Bring it to colour</h3>
          <p>The graphite-plus-blue-and-sanguine palette: warm and cool temperature, and selective colour to lead the eye.</p>
        </div>
        <div class="manual-entry m2">
          <h3><span class="me-mark">M2</span> Finish a full plate</h3>
          <p>Edge control, texture, and a finished composition of intersecting solids — hatched, shaded and coloured, like the reference plate.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- TWO MODULES -->
  <section>
    <div class="wrap">
      <div class="chapter">
        <h2>First the engineering, then the art</h2>
        <p class="ch-intro">Module 1 teaches the precise, correct drawing that describes a real part. Module 2 adds the shading, hatching, and colour that turn it into a finished plate. Do them in order, or dip into Module 2 once you can construct a solid.</p>
      </div>
      <div class="modules">
        <a class="module-plate" href={moduleUrl(1)} style="--mc:var(--m1)">
          <span class="mp-head"><span class="mp-num">Module 1</span><span class="mp-meta">30 lessons · 5 phases</span></span>
          <h3>Technical Drawing</h3>
          <div class="mfig"><Diagram name="three-views" /></div>
          <p>Instruments and line conventions, orthographic projection, isometric and perspective, dimensioning, sections, intersections, and a complete detail drawing.</p>
          <span class="go">Start the course <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
        </a>
        <a class="module-plate" href={moduleUrl(2)} style="--mc:var(--m2)">
          <span class="mp-head"><span class="mp-num">Module 2</span><span class="mp-meta">15 lessons · 4 phases</span></span>
          <h3>Rendering &amp; Colour</h3>
          <div class="mfig"><Diagram name="finished-plate" /></div>
          <p>Value and hatching that follows the form, one convincing light with cast shadows, and the graphite-plus-blue-and-sanguine colour of the academic constructive tradition.</p>
          <span class="go">Open Module 2 <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
        </a>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section>
    <div class="wrap">
      <div class="chapter">
        <h2>Every lesson, the same rhythm</h2>
        <p class="ch-intro">Every lesson is one focused page with the same shape, so you always know what to do. Show up, work the three blocks, check it off, move on.</p>
      </div>
      <div class="session-steps">
        <div class="step"><div class="sn">1</div><div><h3>Open the lesson</h3><p>Each lesson is its own page: a clear goal, a diagram, and roughly 45–90 minutes of work.</p></div></div>
        <div class="step"><div class="sn">2</div><div><h3>Work the blocks</h3><p>A 10-minute warm-up, the main exercise, then a checkpoint that tells you when you've got it.</p></div></div>
        <div class="step"><div class="sn">3</div><div><h3>Check it off</h3><p>Mark it complete. Your progress is saved in the browser and the next lesson is one tap away.</p></div></div>
        <div class="step"><div class="sn">4</div><div><h3>Build up</h3><p>Five phases stack from your first line to a finished sheet — then Module 2 adds shading and colour.</p></div></div>
      </div>
    </div>
  </section>

  <!-- PHASES -->
  <section>
    <div class="wrap">
      <div class="chapter">
        <h2>Nine phases across two modules</h2>
        <p class="ch-intro">Each phase builds on the one before it. Module 1's five phases take you from your first line to a finished sheet; Module 2's four then add tone, light and colour on top.</p>
      </div>
      <div class="phase-ledger">
        {groups.map(({ mm, lessons, phases }) => (
          <Fragment>
            <div class="ledger-mod" style={`--mc:var(--m${mm.m})`}>
              <span class="lm-tag">{mm.tag}</span><span class="lm-title">{mm.title}</span>
              <span class="lm-meta">{lessons.length} lessons · {phases.length} phases</span>
            </div>
            {phases.map((ph) => (
              <div class="ledger-row">
                <div class="lr-lessons">Lessons {ph.data.lessons}</div>
                <div>
                  <h3>{ph.data.name}</h3>
                  <p>{ph.data.blurb}</p>
                </div>
              </div>
            ))}
          </Fragment>
        ))}
      </div>
    </div>
  </section>

  <!-- ROADMAP / CONTENTS -->
  <section>
    <div class="wrap">
      <div class="chapter">
        <div class="chapter-row">
          <h2>Contents — the whole journey</h2>
          <span class="meta-line">finished lessons are ticked ✓</span>
        </div>
        <p class="ch-intro">Every lesson in order, like a table of contents. Open any of them; your progress is saved in this browser.</p>
      </div>
      <div id="roadmap">
        {groups.map(({ mm, lessons }) => (
          <div class="roadmap-group" style={`--mc:var(--m${mm.m})`}>
            <div class="ledger-mod">
              <span class="lm-tag">{mm.tag}</span><span class="lm-title">{mm.title}</span>
              <span class="lm-meta">{lessons.length} lessons</span>
            </div>
            <div class="toc toc-cols">
              {lessons.map((l) => (
                <a class="toc-row" href={lessonUrl(mm.m, l.data.number)} data-m={mm.m} data-n={l.data.number}>
                  <span class="toc-num">{mm.short.charAt(0).toUpperCase()}{mm.m}·{String(l.data.number).padStart(2, '0')}</span>
                  <span class="toc-title">{l.data.title}</span>
                  <span class="toc-leader"></span>
                  <span class="toc-state"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:none"><path class="check-path" d="M20 6 9 17l-5-5"/></svg></span>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
      <div class="center mt-lg">
        <a href={moduleUrl(1)} class="btn btn-primary">Open Module 1 map</a>
        <a href={moduleUrl(2)} class="btn btn-ghost">Open Module 2 map</a>
      </div>
    </div>
  </section>

  <!-- TOOLS + DAILY ROUTINE -->
  <section>
    <div class="wrap">
      <div class="chapter">
        <h2>Your kit and daily routine</h2>
        <p class="ch-intro">You don't need much, and for learning the basics cheap pencil-and-paper tools genuinely beat any software. Here's the whole list.</p>
      </div>
      <div class="kit-cols">
        <div>
          <h3 class="kit-head"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 20 L20 4l-3-3-16 16 3 3zM14 4l3 3"/></svg> Tools</h3>
          <ul class="kit-list">
            <li><span class="k">Paper</span><span class="v"><b>A3, smooth, 90–120 gsm.</b> A grid or dot pad helps early on.</span></li>
            <li><span class="k">Pencils</span><span class="v"><b>2H, HB, 2B.</b> 2H for construction, HB/2B for outlines and tone.</span></li>
            <li><span class="k">Accents</span><span class="v">Optional blue &amp; a warm pencil for highlighting features.</span></li>
            <li><span class="k">Eraser</span><span class="v">Kneaded eraser plus a fine click eraser for details.</span></li>
            <li><span class="k">Ruler</span><span class="v">For <b>checking</b> proportions only — never for drawing lines.</span></li>
          </ul>
        </div>
        <div>
          <h3 class="kit-head"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg> Each lesson · 45–90 min</h3>
          <ul class="kit-list">
            <li><span class="k">10 min</span><span class="v"><b>Warm-up.</b> Freehand straight lines and ellipses.</span></li>
            <li><span class="k">30–60 min</span><span class="v"><b>Main exercise</b> for the current lesson.</span></li>
            <li><span class="k">10 min</span><span class="v"><b>Hatching / lettering</b> practice on scrap.</span></li>
            <li><span class="k">Rhythm</span><span class="v"><b>Six short sessions a week</b> beat one long weekend.</span></li>
          </ul>
        </div>
      </div>
      <div class="margin-note">
        If you take one thing from this page, take this: show up often, even when you only have twenty minutes. Six short sessions a week will get you further than one long weekend push. Your hand learns this by repetition, not by cramming.
        <div class="who">— on building the habit</div>
      </div>
    </div>
  </section>
</Base>

<script type="application/json" id="seq-data" set:html={JSON.stringify(seq)} />
<script>
  import { load } from '../scripts/progress';
  import { ICONS } from '../lib/icons';

  function paintHome() {
    const dataEl = document.getElementById('seq-data');
    if (!dataEl) return;
    const seq = JSON.parse(dataEl.textContent || '[]') as Array<{ m: number; n: number; title: string; url: string }>;
    const done: Record<number, Record<string, 1>> = { 1: load(1), 2: load(2) };
    const next = seq.find((s) => !done[s.m]?.[s.n]);

    document.querySelectorAll<HTMLElement>('#roadmap .toc-row').forEach((row) => {
      const m = Number(row.dataset.m);
      const n = row.dataset.n!;
      const isDone = Boolean(done[m]?.[n]);
      row.classList.toggle('done', isDone);
      row.classList.toggle('next', Boolean(next && next.m === m && String(next.n) === n));
      const mark = row.querySelector<SVGElement>('.toc-state svg');
      if (mark) mark.style.display = isDone ? 'inline' : 'none';
      const state = row.querySelector<HTMLElement>('.toc-state');
      if (state) {
        const label = state.querySelector('.toc-next-label');
        if (next && next.m === m && String(next.n) === n) {
          if (!label) state.insertAdjacentHTML('beforeend', '<span class="toc-next-label">next</span>');
        } else {
          label?.remove();
        }
      }
    });

    const band = document.getElementById('continue-band');
    if (!band) return;
    const started = Object.keys(done[1]).length + Object.keys(done[2]).length > 0;
    if (!next) {
      band.innerHTML = `<div><div class="cb-label">All done</div><div class="cb-title">You've completed every lesson</div><div class="cb-sub">Revisit any lesson, or run the capstone again — it'll be better each time.</div></div>
        <div class="cb-actions"><a href="/module-1/" class="btn btn-ghost">Course map</a></div>`;
    } else {
      const tag = next.m === 1 ? 'Module 1' : 'Module 2';
      const inMod = seq.filter((s) => s.m === next.m);
      const doneInMod = inMod.filter((s) => done[s.m]?.[s.n]).length;
      band.innerHTML = `<div>
          <div class="cb-label">${started ? 'Continue where you left off' : 'Start here'}</div>
          <div class="cb-title">${tag} · Lesson ${next.n} — ${next.title}</div>
          <div class="cb-sub">${started ? `${doneInMod} of ${inMod.length} lessons done in this module` : 'Your first session. All you need is a pencil and paper.'}</div>
        </div>
        <div class="cb-actions"><a href="${next.url}" class="btn btn-primary">${started ? 'Continue' : 'Begin'} ${ICONS.arrow}</a></div>`;
    }
  }

  document.addEventListener('astro:page-load', paintHome);
  document.addEventListener('progresschange', paintHome);
</script>
